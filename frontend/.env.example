# Copy to .env.local and adjust if the backend runs somewhere other than the default.
VITE_API_BASE_URL=http://localhost:8000

# Phase 7 - must match the backend's RISK_API_API_KEY (see ../.env.example).
# The value below is the backend's own committed DEV-ONLY default, so a fresh
# checkout works out of the box locally. NEVER put a real production key in
# this file (or any .env file committed to version control) - see
# reports/phase7_summary.md.
VITE_API_KEY=local-dev-key-CHANGE-ME
